    },
    {
      "id": "line-017",
      "type": "line",
      "source": "ちなみに音量の初期値も[[LINK_1]]CustomizeConfigDefault.js[[/LINK_1]]などで変更しておくことをオススメします。",
      "sourceHash": "19a9c6918d12cd33d70de84f91249e0d55d54e77fbf2814459eceebfa57af552",
      "parts": [
        {
          "source": "ちなみに音量の初期値も",
          "link": false
        },
        {
          "source": "CustomizeConfigDefault.js",
          "link": true,
          "linkIndex": 1
        },
        {
          "source": "などで変更しておくことをオススメします。",
          "link": false
        }
      ],
      "translation": "By the way, I also recommend changing the default volume using [[LINK_1]]CustomizeConfigDefault.js[[/LINK_1]] or another method.",
      "contextHash": "19a9c6918d12cd33d70de84f91249e0d55d54e77fbf2814459eceebfa57af552"
