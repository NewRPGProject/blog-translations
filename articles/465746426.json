  "blocks": [
    {
      "id": "title",
      "type": "title",
      "source": "音楽室目次",
      "sourceHash": "6bd67f528a3f164bece040a866b210b0e51e075a447613c79a44b0357e403eda",
      "translation": "Music Room Table of Contents",
      "contextHash": "6bd67f528a3f164bece040a866b210b0e51e075a447613c79a44b0357e403eda"
    },
    {
      "id": "text-001",
      "type": "text",
      "source": "音楽室を作ってみました。",
      "sourceHash": "6ae7c4f16dcb1707c65659d1ebc60b28a36520c1e7f38b045e3435420283f82f",
      "translation": "I created a music room.",
      "contextHash": "6ae7c4f16dcb1707c65659d1ebc60b28a36520c1e7f38b045e3435420283f82f"
    },
    {
      "id": "text-002",
      "type": "text",
      "source": "ゲーム中で使用した楽曲を鑑賞＆ダウンロードできます。ゲーム中で使用されているものより、音質が若干良かったり、演奏時間が長めだったりします。",
      "sourceHash": "d5a842b0feb884439d12296115eb716cc3b325ce281c8e7f89e3045c5a8f00a1",
      "translation": "You can listen to and download the music used in the game. The audio quality is slightly better and the tracks are somewhat longer than the versions used in the game.",
      "contextHash": "d5a842b0feb884439d12296115eb716cc3b325ce281c8e7f89e3045c5a8f00a1"
    },
    {
      "id": "text-003",
      "type": "text",
      "source": "※ただし、フリー素材は含まれていません。",
      "sourceHash": "78f402795c1403c8b60ca8dcbb940833a929fceac90b4df54987c0dbac966f52",
      "translation": "※However, free materials are not included.",
      "contextHash": "78f402795c1403c8b60ca8dcbb940833a929fceac90b4df54987c0dbac966f52"
    },
    {
      "id": "text-004",
      "type": "text",
      "source": "☆の数は作者のお気に入り度です。",
      "sourceHash": "e3f04b03cd31538c6cfc270847b7604b1506b6d24f140f5374123cb08f28cc75",
      "translation": "The number of ☆s indicates the author's favorites.",
      "contextHash": "e3f04b03cd31538c6cfc270847b7604b1506b6d24f140f5374123cb08f28cc75"
    },
    {
      "id": "link-001",
