      "contextHash": "997d38a2ffbf82e323c9aeaa25da500556817a7f63d199ecca41c0bfe9db2887"
    },
    {
      "id": "list-006",
      "type": "list",
      "source": "指定がない場合に適用される時間の初期値です。",
      "sourceHash": "f3b727a0eb47271cd65f3708e890f6593b43d681a38df4bc288fac5abc4b16e6",
      "translation": "This is the default duration applied when no value is specified.",
      "contextHash": "f3b727a0eb47271cd65f3708e890f6593b43d681a38df4bc288fac5abc4b16e6"
    },
    {
      "id": "list-007",
      "type": "list",
      "source": "各モーション項目をブランクにすると、この値が適用されます。",
      "sourceHash": "fe7eb6c7dc80d5ebb042bfa54c7184791e1f4efa3259104920914de9b4c2d8e0",
      "translation": "When each motion item is left blank, this value is applied.",
      "contextHash": "fe7eb6c7dc80d5ebb042bfa54c7184791e1f4efa3259104920914de9b4c2d8e0"
    },
    {
