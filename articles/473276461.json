      "sourceHash": "e909c498632685a8aa8d1433371dbbaa7135d2f439ae54c912f9d76d31276dbc",
      "translation": "Download the following file and place it in [Project]\\\\js\\\\plugins. Turn the feature ON from RPG Maker MV's Plugin Manager.",
      "contextHash": "e909c498632685a8aa8d1433371dbbaa7135d2f439ae54c912f9d76d31276dbc"
    },
