    },
    {
      "id": "heading-007",
      "type": "heading",
      "source": "モーション時間の初期値（defaultTime）",
      "sourceHash": "997d38a2ffbf82e323c9aeaa25da500556817a7f63d199ecca41c0bfe9db2887",
