      "contextHash": "7ca0c6d889da78f7936d8b6e3d8b18005ce739f0134eaa9b0f6b3df3bbd223a7"
    },
    {
      "id": "list-004",
      "type": "list",
      "source": "なぜか1/30秒単位と勘違いしていましたが、正しくは1/60単位です。",
      "sourceHash": "30c7b2dce0f8534a5c4d0f1c8eb6f127caf10dee5b773adc3ef599023dbd5791",
