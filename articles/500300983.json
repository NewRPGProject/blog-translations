      "contextHash": "7876cc6e169aa1ffb59ad7ff0263d5dbdd1b309638a0319bcebc599acddc70ad"
    },
    {
      "id": "heading-006",
      "type": "heading",
      "source": "控えの経験値獲得率（BenchMembersExpRate）",
      "sourceHash": "f173c94239cbae7cdf4f4a1cae128b4b71aa57825ff51efa091fb1dfbdc52af4",
      "translation": "Reserve Experience Gain Rate (BenchMembersExpRate)",
      "contextHash": "f173c94239cbae7cdf4f4a1cae128b4b71aa57825ff51efa091fb1dfbdc52af4"
    },
    {
      "id": "text-007",
      "type": "text",
      "source": "控えメンバーの経験値獲得率です。",
      "sourceHash": "bf82e567952d93f0609f21703ead753b5f834488e4a3c6c9081da713c00433e9",
      "translation": "This is the experience gain rate for reserve members.",
      "contextHash": "bf82e567952d93f0609f21703ead753b5f834488e4a3c6c9081da713c00433e9"
    },
    {
      "id": "text-008",
      "type": "text",
      "source": "1.00が１００％の意味になります。",
      "sourceHash": "63a570043ce3dc2c940ca9d7011301f8f39c899668ede1b3a7e2006b052e9f66",
      "translation": "1.00 means 100%.",
      "contextHash": "63a570043ce3dc2c940ca9d7011301f8f39c899668ede1b3a7e2006b052e9f66"
    },
    {
      "id": "heading-007",
      "type": "heading",
      "source": "控えのレベルアップ非表示（NoLevelUpMessage）",
      "sourceHash": "1afde9d42a8e7b5bb530556990a44a79adc6d705a80a24709b2a9fdf1e63261c",
      "translation": "Hide Reserve Level-Up Messages (NoLevelUpMessage)",
      "contextHash": "1afde9d42a8e7b5bb530556990a44a79adc6d705a80a24709b2a9fdf1e63261c"
    },
    {
      "id": "text-009",
      "type": "text",
      "source": "控えメンバーのレベルアップメッセージを非表示にします。",
      "sourceHash": "e560eda84db113d176344cf37cd046b52de43431d0bc854b1d3b763a456683dc",
      "translation": "Hides level-up messages for reserve members.",
      "contextHash": "e560eda84db113d176344cf37cd046b52de43431d0bc854b1d3b763a456683dc"
    }
  ],
