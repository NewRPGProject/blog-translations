    },
    {
      "id": "list-001",
      "type": "list",
      "source": "公開！",
      "sourceHash": "db16b64ccc528b64a0ff8adf39553bdd72ca60eb32c274c6a2d0185b3be59664",
      "translation": "Released!",
      "contextHash": "db16b64ccc528b64a0ff8adf39553bdd72ca60eb32c274c6a2d0185b3be59664"
    },
    {
      "id": "list-002",
      "type": "list",
      "source": "装備コマンド選択時にメニュー画面で選んだ直近のアクターが初期選択されてしまう不具合を修正。（2025/04/27 ver1.001）",
      "sourceHash": "30b904b337db225099167282d3fe29263e72079f7a7058dd45d4fb67d6f18e39",
      "translation": "Fixed a bug where the actor most recently selected on the menu screen was initially selected when choosing the Equip command. (2025/04/27 ver1.001)",
      "contextHash": "30b904b337db225099167282d3fe29263e72079f7a7058dd45d4fb67d6f18e39"
    },
    {
      "id": "list-003",
      "type": "list",
      "source": "店に入ってからは選択したアクターは保持しておくようにした。",
      "sourceHash": "68c3dc82c91222e155be7a8c960fc01d41e5a8fcc64a4d8e610ce4d7d029ecad",
      "translation": "The selected actor is now retained after entering a shop.",
      "contextHash": "68c3dc82c91222e155be7a8c960fc01d41e5a8fcc64a4d8e610ce4d7d029ecad"
    },
    {
      "id": "list-004",
      "type": "list",
      "source": "（2025/04/27 ver1.002）",
      "sourceHash": "f69957d9e539d153790a907c5edc6a0f7030282de271cb29761f51a739d54a09",
      "translation": " (2025/04/27 ver1.002) ",
      "contextHash": "f69957d9e539d153790a907c5edc6a0f7030282de271cb29761f51a739d54a09"
    },
    {
      "id": "heading-005",
      "type": "heading",
      "source": "プラグインパラメータ（Plugin Parameters）",
      "sourceHash": "7876cc6e169aa1ffb59ad7ff0263d5dbdd1b309638a0319bcebc599acddc70ad",
      "translation": "Plugin Parameters (Plugin Parameters)",
      "contextHash": "7876cc6e169aa1ffb59ad7ff0263d5dbdd1b309638a0319bcebc599acddc70ad"
    },
    {
      "id": "heading-006",
      "type": "heading",
      "source": "コマンド名（CommandName）",
      "sourceHash": "9559481480bde5b6427c31f3c6f22f37f26248b37ac3ee807944a4dea14e1b5b",
      "translation": "Command Name (CommandName)",
      "contextHash": "9559481480bde5b6427c31f3c6f22f37f26248b37ac3ee807944a4dea14e1b5b"
    },
    {
      "id": "text-006",
      "type": "text",
      "source": "ショップに表示するコマンド名です。",
      "sourceHash": "9a8064a3cf3d228343f459756ac1be41f83374ac84f3d5f5ea05ebca2c08188c",
      "translation": "The command name displayed in shops.",
      "contextHash": "9a8064a3cf3d228343f459756ac1be41f83374ac84f3d5f5ea05ebca2c08188c"
    },
    {
      "id": "text-007",
      "type": "text",
      "source": "空白の場合はデータベースの用語をそのまま使います。",
      "sourceHash": "61b893ba684364d2d2f57a707b77557900b4358fff3cf53569fca08e6ecf36c8",
      "translation": "If left blank, the database terminology will be used as is.",
      "contextHash": "61b893ba684364d2d2f57a707b77557900b4358fff3cf53569fca08e6ecf36c8"
    }
  ],
