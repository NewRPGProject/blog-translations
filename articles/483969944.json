    },
    {
      "id": "list-002",
      "type": "list",
      "source": "テーブル画像を延長しないを追加。",
      "sourceHash": "4742c335da1cc390ec8c20c7a7848a5d98fa15860a5db51f9394a0464c84169f",
      "translation": "Added an option not to extend table images.",
      "contextHash": "4742c335da1cc390ec8c20c7a7848a5d98fa15860a5db51f9394a0464c84169f"
    },
