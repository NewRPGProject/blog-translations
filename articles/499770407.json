    {
      "id": "heading-006",
      "type": "heading",
      "source": "オンにするスイッチ（OnSwitches）",
      "sourceHash": "723da3927f9414cc9b2a91eec019d29855614aa31e5f4fd16a1b20a2a44d1bbf",
      "translation": "Switches to Turn On (OnSwitches)",
      "contextHash": "723da3927f9414cc9b2a91eec019d29855614aa31e5f4fd16a1b20a2a44d1bbf"
    },
    {
      "id": "text-009",
      "type": "text",
      "source": "ゲーム起動時にオンにするスイッチです。",
      "sourceHash": "a87069bf4d899ee4bba451f7d43221ef47000825ce8237d08bb34f5b30254fd3",
      "translation": "These are the switches to turn on when the game starts.",
      "contextHash": "a87069bf4d899ee4bba451f7d43221ef47000825ce8237d08bb34f5b30254fd3"
    },
    {
      "id": "heading-007",
      "type": "heading",
      "source": "オフにするスイッチ（OffSwitches）",
      "sourceHash": "6ea582bdc0f2bd4d1ff979d07f13cc9a17851478db702eb9b090ac93274edd71",
      "translation": "Switches to Turn Off (OffSwitches)",
      "contextHash": "6ea582bdc0f2bd4d1ff979d07f13cc9a17851478db702eb9b090ac93274edd71"
    },
    {
      "id": "text-010",
      "type": "text",
      "source": "ゲーム起動時にオフにするスイッチです。",
      "sourceHash": "61d050e7e1a74fc8875d8fe83591684f83771bcaeb1c053b3629c883bac23ff9",
      "translation": "These are the switches to turn off when the game starts.",
      "contextHash": "61d050e7e1a74fc8875d8fe83591684f83771bcaeb1c053b3629c883bac23ff9"
    }
