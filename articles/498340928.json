    {
      "id": "line-010",
      "type": "line",
      "source": "[[LINK_1]]制限値（LimitNumber）[[/LINK_1]]",
      "sourceHash": "68cbcc6679c58d110875204f129716af58a610ce7f347410ecd50d759b83a277",
      "parts": [
        {
