      "contextHash": "c4683d75613cad584b49b0e71fe6320254f00a89fbc300a422fe3ae29accbac5"
    },
    {
      "id": "text-007",
      "type": "text",
      "source": "再生値同士の表示間隔です。",
      "sourceHash": "13c2a11f114a735ef234cd17fe82791f0b47c9e83729b8065165d80d86e59c61",
      "translation": "The display interval between regeneration values.",
      "contextHash": "13c2a11f114a735ef234cd17fe82791f0b47c9e83729b8065165d80d86e59c61"
    },
    {
      "id": "text-008",
      "type": "text",
      "source": "1/60秒単位で設定してください。",
      "sourceHash": "ae691be50f4efd28ea4de545245da45be1844434fdb8dff5e8b38f0512eb1f5a",
      "translation": "Set this in 1/60-second increments.",
      "contextHash": "ae691be50f4efd28ea4de545245da45be1844434fdb8dff5e8b38f0512eb1f5a"
    }
  ],
