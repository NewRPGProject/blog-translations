          "source": "できるようにした。",
          "link": false
        }
      ],
      "translation": "Since there were situations that were not supported, I made it possible to [[LINK_1]]support all text[[/LINK_1]].",
      "contextHash": "9e2216e4a98fb94d58f3cb2d2a1f0ea29a20a24219f75fe02224dbc8682bf120"
    },
    {
